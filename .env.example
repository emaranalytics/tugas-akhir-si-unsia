# Copy this file to .env and fill local values before running experiments.

APP_ENV=local
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
EVAL_BACKEND=synthetic
EVAL_MAX_SCENARIO=S4
EVAL_QUERY_LIMIT=0
EVAL_TOOL_BUDGET=15
EVAL_LIVE_BASELINE=false
EVAL_REPEAT_RUNS=1
EVAL_OUTPUT_SUBDIR=
EVAL_BASELINE_MAX_SCENARIO=
